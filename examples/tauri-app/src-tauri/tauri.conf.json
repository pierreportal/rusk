{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rusk-example",
  "version": "0.1.0",
  "identifier": "dev.rusk.example",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rusk Example",
        "width": 800,
        "height": 480,
        "fullscreen": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
